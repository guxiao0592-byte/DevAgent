# ============================================================================
# DevAgent v3.4 — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# At least ONE provider key is required.

# --- DeepSeek (recommended for Chinese + cost efficiency) ---
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- OpenAI (GPT-4 for best quality) ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Huawei Cloud (optional) ---
# HUAWEI_API_KEY=your-huawei-key-here

# --- DevAgent Settings ---
# DEVAGENT_CONFIG=/app/devagent/configs/config.yaml
# DEVAGENT_INTERACTIVE=off
